{
  "manifest_version": 1,
  "type": "device",
  "name": "Team Tracker",
  "description": {
    "en": "Follow your sports teams: live scores, next match, and scenes when your team scores.",
    "fr": "Suivez vos équipes : scores en direct, prochain match et scènes quand votre équipe marque.",
    "de": "Verfolge deine Teams: Live-Ergebnisse, nächstes Spiel und Szenen, wenn dein Team punktet.",
    "es": "Siga a sus equipos: resultados en directo, próximo partido y escenas cuando su equipo marca."
  },
  "version": "1.1.1",
  "docker_image": "ghcr.io/prohand/gladys-teamtracker:1.1.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-teamtracker/main/cover.png",
  "categories": ["leisure", "services", "multimedia"],
  "keywords": [
    "espn",
    "football",
    "soccer",
    "rugby",
    "basketball",
    "hockey",
    "nfl",
    "nba",
    "ligue 1",
    "premier league"
  ],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Scores come from the public ESPN API: no account, no key. Write the teams to follow as LEAGUE:TEAM, separated by commas, e.g. LIG1:PSG, TOP14:RAC, NFL:KC. Not sure of the abbreviation? Use the \"Find a team\" button below. Each team becomes a device in the Discover tab.",
        "fr": "Les scores viennent de l'API publique d'ESPN : pas de compte, pas de clé. Écrivez les équipes à suivre sous la forme LIGUE:ÉQUIPE, séparées par des virgules, par ex. LIG1:PSG, TOP14:RAC, NFL:KC. Pas sûr de l'abréviation ? Utilisez le bouton « Trouver une équipe » plus bas. Chaque équipe devient un appareil dans l'onglet Découverte.",
        "de": "Die Ergebnisse stammen aus der öffentlichen ESPN-API: kein Konto, kein Schlüssel. Schreib die zu verfolgenden Teams als LIGA:TEAM, durch Kommas getrennt, z. B. LIG1:PSG, TOP14:RAC, NFL:KC. Unsicher bei der Abkürzung? Nutze unten die Schaltfläche „Team suchen“. Jedes Team wird zu einem Gerät im Tab „Entdecken“.",
        "es": "Los resultados proceden de la API pública de ESPN: sin cuenta ni clave. Escriba los equipos que desea seguir como LIGA:EQUIPO, separados por comas, p. ej. LIG1:PSG, TOP14:RAC, NFL:KC. ¿No está seguro de la abreviatura? Use el botón «Buscar un equipo» más abajo. Cada equipo se convierte en un dispositivo en la pestaña «Descubrir»."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-teamtracker/blob/main/docs/en.md#leagues",
          "label": {
            "en": "League codes",
            "fr": "Codes des ligues",
            "de": "Liga-Codes",
            "es": "Códigos de las ligas"
          }
        }
      ]
    },
    {
      "key": "teams",
      "type": "string",
      "label": {
        "en": "Teams",
        "fr": "Équipes",
        "de": "Teams",
        "es": "Equipos"
      },
      "description": {
        "en": "LEAGUE:TEAM entries separated by commas (20 at most). The team is its abbreviation or its ESPN id.",
        "fr": "Entrées LIGUE:ÉQUIPE séparées par des virgules (20 au plus). L'équipe est son abréviation ou son identifiant ESPN.",
        "de": "Einträge LIGA:TEAM, durch Kommas getrennt (höchstens 20). Das Team ist seine Abkürzung oder seine ESPN-ID.",
        "es": "Entradas LIGA:EQUIPO separadas por comas (20 como máximo). El equipo es su abreviatura o su identificador ESPN."
      },
      "placeholder": {
        "en": "e.g. LIG1:PSG, NFL:KC",
        "fr": "ex. LIG1:PSG, NFL:KC",
        "de": "z. B. LIG1:PSG, NFL:KC",
        "es": "p. ej. LIG1:PSG, NFL:KC"
      },
      "required": true
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the match texts",
        "fr": "Langue des textes de match",
        "de": "Sprache der Spieltexte",
        "es": "Idioma de los textos del partido"
      },
      "description": {
        "en": "Language of the \"Match\" text shown on the devices and sent to the scenes.",
        "fr": "Langue du texte « Match » affiché sur les appareils et envoyé aux scènes.",
        "de": "Sprache des Texts „Spiel“, der auf den Geräten angezeigt und an die Szenen gesendet wird.",
        "es": "Idioma del texto «Partido» mostrado en los dispositivos y enviado a las escenas."
      },
      "required": false,
      "default": "en",
      "display": "radio",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
