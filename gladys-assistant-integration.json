{
  "manifest_version": 1,
  "type": "device",
  "name": "Team Tracker",
  "description": {
    "en": "Follow your sports teams: live scores, next match, and scenes when your team scores.",
    "fr": "Suivez vos équipes : scores en direct, prochain match et scènes quand votre équipe marque."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/prohand/gladys-teamtracker:1.0.2",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-teamtracker/main/cover.png",
  "categories": ["services", "multimedia"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Scores come from the public ESPN API: no account, no key. Write the teams to follow as LEAGUE:TEAM, separated by commas, e.g. LIG1:PSG, TOP14:RAC, NFL:KC. Not sure of the abbreviation? Use the \"Find a team\" button below. Each team becomes a device in the Discovery tab.",
        "fr": "Les scores viennent de l'API publique d'ESPN : pas de compte, pas de clé. Écrivez les équipes à suivre sous la forme LIGUE:ÉQUIPE, séparées par des virgules, par ex. LIG1:PSG, TOP14:RAC, NFL:KC. Pas sûr de l'abréviation ? Utilisez le bouton « Trouver une équipe » plus bas. Chaque équipe devient un appareil dans l'onglet Découverte."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-teamtracker/blob/main/docs/en.md#leagues",
          "label": {
            "en": "League codes",
            "fr": "Codes des ligues"
          }
        }
      ]
    },
    {
      "key": "teams",
      "type": "string",
      "label": {
        "en": "Teams",
        "fr": "Équipes"
      },
      "description": {
        "en": "LEAGUE:TEAM entries separated by commas (20 at most). The team is its abbreviation or its ESPN id.",
        "fr": "Entrées LIGUE:ÉQUIPE séparées par des virgules (20 au plus). L'équipe est son abréviation ou son identifiant ESPN."
      },
      "placeholder": {
        "en": "e.g. LIG1:PSG, NFL:KC",
        "fr": "ex. LIG1:PSG, NFL:KC"
      },
      "required": true
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the match texts",
        "fr": "Langue des textes de match"
      },
      "description": {
        "en": "Language of the \"Match\" text shown on the devices and sent to the scenes.",
        "fr": "Langue du texte « Match » affiché sur les appareils et envoyé aux scènes."
      },
      "required": false,
      "default": "en",
      "display": "radio",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "description": {
        "en": "Kickoff times are written in this time zone (IANA name).",
        "fr": "Les heures de coup d'envoi sont écrites dans ce fuseau (nom IANA)."
      },
      "placeholder": {
        "en": "e.g. America/New_York",
        "fr": "ex. Europe/Paris"
      },
      "required": false,
      "default": "Europe/Paris"
    },
    {
      "key": "reminder_minutes",
      "type": "number",
      "label": {
        "en": "Kickoff reminder (min)",
        "fr": "Rappel avant le coup d'envoi (min)"
      },
      "description": {
        "en": "The \"Match starting soon\" trigger fires this many minutes before kickoff. 0 turns it off.",
        "fr": "Le déclencheur « Match bientôt » part ce nombre de minutes avant le coup d'envoi. 0 le désactive."
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 1440
    },
    {
      "key": "live_refresh",
      "type": "number",
      "label": {
        "en": "Refresh during a match (s)",
        "fr": "Actualisation pendant un match (s)"
      },
      "description": {
        "en": "How often scores are read while a match is live, in seconds.",
        "fr": "Fréquence de lecture des scores pendant un match, en secondes."
      },
      "required": false,
      "default": 30,
      "min": 15,
      "max": 300
    },
    {
      "key": "idle_refresh",
      "type": "number",
      "label": {
        "en": "Refresh between matches (min)",
        "fr": "Actualisation entre les matchs (min)"
      },
      "description": {
        "en": "How often the next matches are checked when nothing is live, in minutes.",
        "fr": "Fréquence de vérification des prochains matchs quand rien n'est en direct, en minutes."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 120
    }
  ],
  "actions": [
    {
      "key": "test_teams",
      "label": {
        "en": "Test the teams",
        "fr": "Tester les équipes"
      },
      "description": {
        "en": "Read ESPN now and show, team by team, what is followed.",
