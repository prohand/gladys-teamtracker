        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire",
        "de": "Zeitzone",
        "es": "Zona horaria"
      },
      "description": {
        "en": "Kickoff times are written in this time zone (IANA name).",
        "fr": "Les heures de coup d'envoi sont écrites dans ce fuseau (nom IANA).",
        "de": "Anstoßzeiten werden in dieser Zeitzone angegeben (IANA-Name).",
        "es": "Las horas de inicio se escriben en esta zona horaria (nombre IANA)."
      },
      "placeholder": {
        "en": "e.g. America/New_York",
        "fr": "ex. Europe/Paris",
        "de": "z. B. Europe/Berlin",
        "es": "p. ej. Europe/Madrid"
      },
      "required": false,
      "default": "Europe/Paris"
    },
    {
      "key": "reminder_minutes",
      "type": "number",
      "label": {
        "en": "Kickoff reminder (min)",
        "fr": "Rappel avant le coup d'envoi (min)",
        "de": "Erinnerung vor Anstoß (min)",
        "es": "Aviso antes del inicio (min)"
      },
      "description": {
        "en": "The \"Match starting soon\" trigger fires this many minutes before kickoff. 0 turns it off.",
        "fr": "Le déclencheur « Match bientôt » part ce nombre de minutes avant le coup d'envoi. 0 le désactive.",
        "de": "Der Auslöser „Spiel beginnt bald“ wird so viele Minuten vor dem Anstoß ausgelöst. 0 schaltet ihn aus.",
        "es": "El desencadenante «El partido empieza pronto» se activa estos minutos antes del inicio. 0 lo desactiva."
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 1440
    },
    {
      "key": "live_refresh",
      "type": "number",
      "label": {
        "en": "Refresh during a match (s)",
        "fr": "Actualisation pendant un match (s)",
        "de": "Aktualisierung während eines Spiels (s)",
        "es": "Actualización durante un partido (s)"
      },
      "description": {
        "en": "How often scores are read while a match is live, in seconds.",
        "fr": "Fréquence de lecture des scores pendant un match, en secondes.",
        "de": "Wie oft die Ergebnisse während eines laufenden Spiels gelesen werden, in Sekunden.",
        "es": "Frecuencia de lectura de los resultados durante un partido en directo, en segundos."
      },
      "required": false,
      "default": 30,
      "min": 15,
      "max": 300
    },
    {
      "key": "idle_refresh",
      "type": "number",
      "label": {
        "en": "Refresh between matches (min)",
        "fr": "Actualisation entre les matchs (min)",
        "de": "Aktualisierung zwischen Spielen (min)",
        "es": "Actualización entre partidos (min)"
      },
      "description": {
        "en": "How often the next matches are checked when nothing is live, in minutes.",
        "fr": "Fréquence de vérification des prochains matchs quand rien n'est en direct, en minutes.",
        "de": "Wie oft die nächsten Spiele geprüft werden, wenn kein Spiel läuft, in Minuten.",
        "es": "Frecuencia de comprobación de los próximos partidos cuando no hay nada en directo, en minutos."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 120
    }
  ],
